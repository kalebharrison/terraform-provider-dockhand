# Copy to .env and fill in real values. Never commit .env.
# Provider config (see docs/LOCAL_DEV.md and AGENTS.md)

DOCKHAND_ENDPOINT=http://127.0.0.1:13001
DOCKHAND_USERNAME=
DOCKHAND_PASSWORD=
DOCKHAND_AUTH_PROVIDER=local
DOCKHAND_DEFAULT_ENV=
DOCKHAND_INSECURE=false

# Optional
# DOCKHAND_MFA_TOKEN=
# DOCKHAND_ALLOW_UNAUTHENTICATED=false

# Acceptance harness overrides (scripts/run-acceptance-harness.sh)
# DOCKHAND_TEST_ENDPOINT=http://127.0.0.1:13001
# DOCKHAND_TEST_USERNAME=tfacc
# DOCKHAND_TEST_PASSWORD=
# DOCKHAND_TEST_AUTH_PROVIDER=local
